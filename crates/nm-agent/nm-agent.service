[Unit]
Description=Network Monitor Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# User service: config lives in the home directory after `nm-agent setup`
ExecStart=/usr/local/bin/nm-agent run
Restart=on-failure
RestartSec=10
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
# Alternatively grant capabilities to the binary:
# setcap cap_net_raw,cap_net_admin+ep /usr/local/bin/nm-agent

[Install]
WantedBy=default.target
